# Runtime dirs created by setup.bat / install.bat — never commit these
models/
venvs/
logs/
ComfyUI/
hailuo/
outputs/
output/
temp/
tmp/

# Hugging Face cache
hf/
.cache/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
env/

# Node
node_modules/

# Secrets / local config
.env
*.local
*token*.txt
hf_token*

# OS / editor
Thumbs.db
desktop.ini
.DS_Store
.idea/
.vscode/

# Stray git lock files moved aside by Claude (safe to delete this folder)
_to_delete/

# Cloned upstream source, not ours to vendor (setup.bat fetches it)
third_party/

# llama.cpp prebuilt binaries (get-llama.bat fetches them)
llama/

# Generated stories, chapters, shot scripts and asset libraries (step 1-3 output)
projects/

# Local tool symlinks (launch.sh points PATH here; ffmpeg -> venvs/tools imageio-ffmpeg)
bin/
